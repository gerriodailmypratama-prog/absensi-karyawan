rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DIBEKUKAN 29 Sep 2026 (PR-CL116): absensi GoodGems pindah ke Supabase (skema `absensi`).
    // Firebase tinggal arsip: tidak ada yang boleh menulis; yang boleh membaca cuma owner.
    // Batalkan pembekuan (rollback) = deploy ulang firestore.rules dari commit sebelum PR-CL116.
    match /{document=**} {
      allow read: if request.auth != null
        && request.auth.token.email in ['gerriomail@gmail.com', 'steffieerzamia@gmail.com'];
      allow write: if false;
    }
  }
}
