rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: cek apakah requester adalah owner
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['gerriomail@gmail.com', 'steffieerzamia@gmail.com'];
    }

    // Field profil yang boleh diisi karyawan dari sisi mereka sendiri (rekening/KTP)
    function profilFields() {
      return ['namaBank', 'nomorRekening', 'atasNamaRek',
              'ktpUrl', 'profilLocked', 'rekeningLocked', 'profilUpdatedAt'];
    }

    // Field USULAN hari libur yang boleh diisi karyawan sendiri.
    // Owner tetap satu-satunya yang menetapkan liburHari final (bukan lewat sini).
    function liburRequestFields() {
      return ['liburRequest', 'liburRequestAt', 'liburRequestPending', 'updatedAt'];
    }

    // Akses SPV (PR-CL98): supervisor boleh MEMBACA event absensi semua orang supaya bisa
    // memantau kehadiran realtime. Sengaja TIDAK diberi akses ke koleksi karyawan, jadi
    // gaji / KTP / rekening tetap tertutup buat dia -- bukan cuma disembunyikan di tampilan.
    function isSpv() {
      return request.auth != null
        && exists(/databases/$(database)/documents/karyawan/$(request.auth.uid))
        && get(/databases/$(database)/documents/karyawan/$(request.auth.uid)).data.get('spvAkses', false) == true;
    }

    // Field PENGAJUAN kasbon yang boleh ditulis karyawan sendiri (PR-CL93).
    // Nilai kasbonAktif / kasbonPlafonPersen / potonganBulan TETAP hanya owner —
    // jadi karyawan tidak bisa membuka aksesnya sendiri atau memindahkan uang.
    function kasbonRequestFields() {
      return ['kasbonRequest', 'kasbonRequestAt', 'updatedAt'];
    }

    // Koleksi absensi (clock in/out, OT)
    match /absensi/{docId} {
      allow read: if request.auth != null && (
        isOwner() || isSpv() || resource.data.uid == request.auth.uid
      );
      // Create: owner boleh bikin event untuk siapa saja; karyawan hanya untuk dirinya sendiri
      allow create: if request.auth != null && (
        isOwner() || request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isOwner();
    }

    // Koleksi karyawan (data profile karyawan)
    match /karyawan/{uid} {
      allow read: if request.auth != null && (
        isOwner() || request.auth.uid == uid
      );
      allow create: if request.auth != null && (
        isOwner() || request.auth.uid == uid
      );
      // Owner bebas update. Karyawan boleh perbaiki field profil mereka sendiri (rekening/KTP)
      // dan mengirim usulan hari libur, TAPI tidak bisa menyentuh field gaji / liburHari final.
      allow update: if isOwner() || (
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(profilFields().concat(liburRequestFields()).concat(kasbonRequestFields()))
        // Kasbon: hanya boleh diajukan kalau owner sudah membuka akses (kasbonAktif true),
        // dan statusnya WAJIB 'menunggu' — karyawan tidak bisa menyetujui pengajuannya sendiri.
        && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kasbonRequest'])
             || ( resource.data.get('kasbonAktif', false) == true
                  && request.resource.data.kasbonRequest.status == 'menunggu' ) )
        // KTP immutable: karyawan hanya boleh SET ktpUrl saat masih kosong (upload pertama),
        // tidak boleh mengubah / menghapus KTP yang sudah ada. Owner tetap bisa (cabang isOwner di atas).
        && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ktpUrl'])
             || resource.data.get('ktpUrl', '') == '' )
      );
      allow delete: if isOwner();
    }

    // Koleksi profil (foto profil & nama karyawan)
    match /profil/{uid} {
      allow read: if request.auth != null;
      // Owner ikut boleh nulis (PR-CL96): dashboard owner menyalin tanggal-bulan ulang tahun
      // ke sini supaya ucapan langsung jalan untuk SEMUA orang, tanpa nunggu yang bersangkutan
      // login duluan. Isinya cuma tanggal-bulan + nama panggilan, tanpa tahun lahir.
      allow create, update: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow delete: if isOwner();
    }
  }
}
